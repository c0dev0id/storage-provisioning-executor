sh -c 'dd if=/dev/zero of='"'"'/dev/disk/by-id/nvme_Vendor_device_Serial1'"'"' bs=1M status=none conv=fdatasync 2>/dev/null || true' || true
# create gpt partition table on /dev/disk/by-id/nvme_Vendor_device_Serial1
parted -s /dev/disk/by-id/nvme_Vendor_device_Serial1 mklabel gpt

# === part-ssd1 (partition) ===
# create partition 1 (part-ssd1) on /dev/disk/by-id/nvme_Vendor_device_Serial1
parted -s -a optimal /dev/disk/by-id/nvme_Vendor_device_Serial1 -- mkpart part-ssd1 2048s 100%
sgdisk --partition-guid=1:xyz /dev/disk/by-id/nvme_Vendor_device_Serial1
# ensure /dev/disk/by-id/nvme_Vendor_device_Serial1p1 is accessible
sh -c 'partx -u /dev/disk/by-id/nvme_Vendor_device_Serial1 2>/dev/null; i=0; while [ $i -lt 50 ] && ! [ -f /sys/class/block/nvme_Vendor_device_Serial1p1/dev ]; do sleep 0.1; i=$((i+1)); done; if ! [ -b /dev/disk/by-id/nvme_Vendor_device_Serial1p1 ] && [ -f /sys/class/block/nvme_Vendor_device_Serial1p1/dev ]; then D=$(cat /sys/class/block/nvme_Vendor_device_Serial1p1/dev); mknod /dev/disk/by-id/nvme_Vendor_device_Serial1p1 b "${D%:*}" "${D#*:}"; fi' || true

# === hw-ssd2 (hardware) ===
# zero first 1024 MiB of /dev/disk/by-id/nvme_Vendor_device_Serial2
dd if=/dev/zero of=/dev/disk/by-id/nvme_Vendor_device_Serial2 bs=1M count=1024 conv=fdatasync status=none
# create gpt partition table on /dev/disk/by-id/nvme_Vendor_device_Serial2
parted -s /dev/disk/by-id/nvme_Vendor_device_Serial2 mklabel gpt

# === part-ssd2 (partition) ===
# create partition 1 (part-ssd2) on /dev/disk/by-id/nvme_Vendor_device_Serial2
parted -s -a optimal /dev/disk/by-id/nvme_Vendor_device_Serial2 -- mkpart part-ssd2 2048s 100%
sgdisk --partition-guid=1:xyz /dev/disk/by-id/nvme_Vendor_device_Serial2
# ensure /dev/disk/by-id/nvme_Vendor_device_Serial2p1 is accessible
sh -c 'partx -u /dev/disk/by-id/nvme_Vendor_device_Serial2 2>/dev/null; i=0; while [ $i -lt 50 ] && ! [ -f /sys/class/block/nvme_Vendor_device_Serial2p1/dev ]; do sleep 0.1; i=$((i+1)); done; if ! [ -b /dev/disk/by-id/nvme_Vendor_device_Serial2p1 ] && [ -f /sys/class/block/nvme_Vendor_device_Serial2p1/dev ]; then D=$(cat /sys/class/block/nvme_Vendor_device_Serial2p1/dev); mknod /dev/disk/by-id/nvme_Vendor_device_Serial2p1 b "${D%:*}" "${D#*:}"; fi' || true

# === nvme-softraid (raid1) ===
# zero mdraid superblock on /dev/disk/by-id/nvme_Vendor_device_Serial1p1
mdadm --zero-superblock --force /dev/disk/by-id/nvme_Vendor_device_Serial1p1 || true
# zero mdraid superblock on /dev/disk/by-id/nvme_Vendor_device_Serial2p1
mdadm --zero-superblock --force /dev/disk/by-id/nvme_Vendor_device_Serial2p1 || true
# create md128 from /dev/disk/by-id/nvme_Vendor_device_Serial1p1 /dev/disk/by-id/nvme_Vendor_device_Serial2p1
mdadm --create --verbose --run --force --assume-clean --metadata=1.2 --level=1 --raid-devices=2 /dev/md128 /dev/disk/by-id/nvme_Vendor_device_Serial1p1 /dev/disk/by-id/nvme_Vendor_device_Serial2p1

