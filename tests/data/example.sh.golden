mkdir -p /target/srv
# mount /dev/md128 at /target/srv
mount /dev/md128 /target/srv

# === fs-efi (filesystem) ===
# create fat32 on /dev/sda1
mkfs.vfat -F 32 -n FOO-EFI /dev/sda1
