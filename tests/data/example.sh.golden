mkfs.ext4 -F -L foo-boot /dev/sda2
# ensure mountpoint /target/boot
mkdir -p /target/boot
# mount /dev/sda2 at /target/boot
mount /dev/sda2 /target/boot

# === xfs-softraid (filesystem) ===
