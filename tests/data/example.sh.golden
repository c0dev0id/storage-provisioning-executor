# Re-emit by rerunning: sprov --script <spec.yaml>

set -eu

# === hw-sda (hardware) ===
# create gpt partition table on /dev/sda
parted -s /dev/sda mklabel gpt

# === part-EFI (partition) ===
# create partition 1 (EFI) on /dev/sda
parted -s -a optimal /dev/sda -- mkpart EFI 2048s 4097MiB
parted -s /dev/sda set 1 boot on
parted -s /dev/sda set 1 esp on
sgdisk --partition-guid=1:xyz /dev/sda
# ensure /dev/sda1 is accessible
sh -c 'partx -u /dev/sda 2>/dev/null; i=0; while [ $i -lt 50 ] && ! [ -f /sys/class/block/sda1/dev ]; do sleep 0.1; i=$((i+1)); done; if ! [ -b /dev/sda1 ] && [ -f /sys/class/block/sda1/dev ]; then D=$(cat /sys/class/block/sda1/dev); mknod /dev/sda1 b "${D%:*}" "${D#*:}"; fi' || true

# === part-boot (partition) ===
# create partition 2 (boot) on /dev/sda
parted -s -a optimal /dev/sda -- mkpart boot 4097MiB 8193MiB
sgdisk --partition-guid=2:xzy /dev/sda
# ensure /dev/sda2 is accessible
sh -c 'partx -u /dev/sda 2>/dev/null; i=0; while [ $i -lt 50 ] && ! [ -f /sys/class/block/sda2/dev ]; do sleep 0.1; i=$((i+1)); done; if ! [ -b /dev/sda2 ] && [ -f /sys/class/block/sda2/dev ]; then D=$(cat /sys/class/block/sda2/dev); mknod /dev/sda2 b "${D%:*}" "${D#*:}"; fi' || true

# === part-lvm-pv (partition) ===
# create partition 3 (lvm-pv) on /dev/sda
parted -s -a optimal /dev/sda -- mkpart lvm-pv 8193MiB 33793MiB
# ensure /dev/sda3 is accessible
sh -c 'partx -u /dev/sda 2>/dev/null; i=0; while [ $i -lt 50 ] && ! [ -f /sys/class/block/sda3/dev ]; do sleep 0.1; i=$((i+1)); done; if ! [ -b /dev/sda3 ] && [ -f /sys/class/block/sda3/dev ]; then D=$(cat /sys/class/block/sda3/dev); mknod /dev/sda3 b "${D%:*}" "${D#*:}"; fi' || true

# === lvm-pv (lvm-pv) ===
# create PV on /dev/sda3
pvcreate -ff -y /dev/sda3

# === lvm-vg-host (lvm-vg) ===
# create VG lvm-vg-host
vgcreate -f -y lvm-vg-host /dev/sda3

# === lvm-lv-c_root (lvm-lv) ===
# create LV lvm-vg-host/c_root
lvcreate -y -W y -L 8589934592B -n c_root lvm-vg-host

# === crypt-root (dm-crypt-luks) ===
# LUKS2 format /dev/lvm-vg-host/c_root
cryptsetup -q --type luks2 luksFormat --key-file=- /dev/lvm-vg-host/c_root <<'SPROV_STDIN_EOF'
1234
SPROV_STDIN_EOF
# open /dev/lvm-vg-host/c_root as crypt-root
cryptsetup -q open --type luks2 --key-file=- /dev/lvm-vg-host/c_root crypt-root <<'SPROV_STDIN_EOF'
1234
SPROV_STDIN_EOF
# add passphrase to slot 3
cryptsetup -q luksAddKey --key-slot=3 --key-file=- /dev/lvm-vg-host/c_root <<'SPROV_STDIN_EOF'
1234
1234
SPROV_STDIN_EOF
# remove default slot 0
cryptsetup -q luksKillSlot --key-file=- /dev/lvm-vg-host/c_root 0 <<'SPROV_STDIN_EOF'
1234
SPROV_STDIN_EOF

